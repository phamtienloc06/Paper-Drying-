# Thông tin REST/WebSocket ThingsBoard chỉ dùng ở backend SCADA.
TB_BASE_URL=https://thingsboard.cloud
TB_USERNAME=replace_with_thingsboard_username
TB_PASSWORD=replace_with_thingsboard_password
TB_DEVICE_ID=replace_with_device_uuid
TB_RPC_TIMEOUT_S=15

# Tài khoản web SCADA riêng; không gửi các thông tin này xuống trình duyệt.
SCADA_USERNAME=replace_with_scada_username
SCADA_PASSWORD=replace_with_scada_password
SCADA_SECRET_KEY=replace_with_a_long_random_secret

# Chỉ bind 0.0.0.0 khi có mạng tin cậy hoặc reverse proxy HTTPS bảo vệ.
SCADA_HOST=127.0.0.1
SCADA_PORT=8080
SCADA_COOKIE_SECURE=false
